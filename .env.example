# Copy to .env and fill in after your AdSense account is approved.
# Publisher ID (looks like ca-pub-1234567890123456)
VITE_ADSENSE_CLIENT=

# Create 4 display ad units in AdSense (responsive) and paste their slot IDs.
VITE_AD_SLOT_LEADERBOARD=
VITE_AD_SLOT_RECTANGLE=
VITE_AD_SLOT_SIDEBAR=
VITE_AD_SLOT_INFEED=

# Optional: Formspree / any endpoint that accepts JSON POST for forms.
VITE_FORM_ENDPOINT=

# Show labelled "Google ad space" boxes in a production build before AdSense is approved (always shown in dev).
# Leave empty/false for a clean site.
VITE_SHOW_AD_PLACEHOLDERS=false

# ---- Admin dashboard / API (server/index.js) ----
ADMIN_PASSWORD=
ADMIN_SECRET=
PORT=4000
